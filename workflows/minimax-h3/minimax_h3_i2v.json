:"STRING","widget":{"name":"value"},"link":null}],"outputs":[{"localized_name":"문자열","name":"STRING","type":"STRING","links":[249]}],"title":"user_prompt","properties":{"cnr_id":"comfy-core","ver":"0.30.0","Node name for S&R":"PrimitiveStringMultiline"},"widgets_values":["modern japanese animation style video. sensual and erotic anime effect. A young woman breathing heavily, has passionate sex in doggy position with a man. from side view. both engaged in passionate sexual intercourse; her body moves rhythmically, causing the man’s penis to intermittently touch her vagina, rendered in a sensual, intimate style with soft, warm lighting that emphasizes skin texture and movement, framed as a realistic photograph capturing the moment with naturalistic depth of field and subtle motion blur to convey energy and passion, no additional props or characters present, maintaining strict fidelity to the described spatial relationship and physical interaction. woman's sexy moan and \nerotic skin friction sound. dynv2 is a trigger keyword for lora."]},{"id":114,"type":"LoadImage","pos":[-1610,4860],"size":[450,630],"flags":{},"order":6,"mode":0,"inputs":[{"localized_name":"이미지","name":"image","type":"COMBO","widget":{"name":"image"},"link":null},{"localized_name":"업로드할 파일 선택","name":"upload","type":"IMAGEUPLOAD","widget":{"name":"upload"},"link":null}],"outputs":[{"localized_name":"이미지","name":"IMAGE","type":"IMAGE","links":[218,246]},{"localized_name":"마스크","name":"MASK","type":"MASK","links":null}],"properties":{"cnr_id":"comfy-core","ver":"0.33.0","Node name for S&R":"LoadImage"},"widgets_values":["ComfyUI_00002_.png","image"]},{"id":105,"type":"4c314f31-ecda-4b08-ae98-faaba1bf613f","pos":[-758.9112965257864,4847.257187934199],"size":[480,630],"flags":{},"order":12,"mode":0,"inputs":[{"name":"first_frame","shape":7,"type":"IMAGE","link":218},{"name":"last_frame","shape":7,"type":"IMAGE","link":null},{"name":"prompt","type":"STRING","widget":{"name":"prompt"},"link":253},{"name":