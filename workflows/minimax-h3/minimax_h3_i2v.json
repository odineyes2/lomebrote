ing_mode.min_p","type":"FLOAT","widget":{"name":"sampling_mode.min_p"},"link":null},{"localized_name":"반복 패널티","name":"sampling_mode.repetition_penalty","type":"FLOAT","widget":{"name":"sampling_mode.repetition_penalty"},"link":null},{"localized_name":"시드","name":"sampling_mode.seed","type":"INT","widget":{"name":"sampling_mode.seed"},"link":null},{"localized_name":"presence_penalty","name":"sampling_mode.presence_penalty","shape":7,"type":"FLOAT","widget":{"name":"sampling_mode.presence_penalty"},"link":null},{"localized_name":"생각 중","name":"thinking","shape":7,"type":"BOOLEAN","widget":{"name":"thinking"},"link":null},{"localized_name":"use_default_template","name":"use_default_template","shape":7,"type":"BOOLEAN","widget":{"name":"use_default_template"},"link":null}],"outputs":[{"localized_name":"생성된 텍스트","name":"generated_text","type":"STRING","links":[252]}],"properties":{"cnr_id":"comfy-core","ver":"0.30.0","Node name for S&R":"TextGenerate"},"widgets_values":["",512,"on",0.7,64,0.95,0.05,1.05,0,0,true,true]},{"id":129,"type":"CLIPLoader","pos":[-1153.7981611932287,4093.4404404801007],"size":[270,106],"flags":{},"order":3,"mode":0,"inputs":[{"localized_name":"CLIP 파일명","name":"clip_name","type":"COMBO","widget":{"name":"clip_name"},"link":null},{"localized_name":"유형","name":"type","type":"COMBO","widget":{"name":"type"},"link":null},{"localized_name":"장치","name":"device","shape":7,"type":"COMBO","widget":{"name":"device"},"link":null}],"outputs":[{"localized_name":"CLIP","name":"CLIP","type":"CLIP","links":[250]}],"properties":{"cnr_id":"comfy-core","ver":"0.30.0","Node name for S&R":"CLIPLoader"},"widgets_values":["Huihui-qwen3vl_4b_fp8_scaled.safetensors","krea2","default"]},{"id":128,"type":"StringConcatenate","pos":[-1279.1570912966647,4257.907566112896],"size":[400,200],"flags":{},"order":7,"mode":0,"inputs":[{"localized_name":"문자열_a","name":"string_a","type":"STRING","widget":{"name":"string_a"},"link":254},{"localized_name":"문자열_b","name":"string_b","type":"STRING","widget":{"name":"string_b"},"link":249},{"localized_name":"구분자","name":"delimiter","type":"STRING","widget":{"name":"delimiter"},"link":null}],"outputs":[{"localized_name":"문자열","name":"STRING","type":"STRING","links":[251]}],"properties":{"cnr_id":"comfy-core","ver":"0.30.0","Node name for S&R":"StringConcatenate"},"widgets_values":["","",""]},{"id":131,"type":"PreviewAny","pos":[-398.8603584208549,4189.315138605448],"size":[470,550],"flags":{"collapsed":false},"order":11,"mode":0,"inputs":[{"localized_name":"소스","name":"source","type":"*","link":252}],"outputs":[{"localized_name":"문자열","name":"STRING","type":"STRING","links":[253]}],"properties":{"cnr_id":"comfy-core","ver":"0.25.0","Node name for S&R":"PreviewAny"},"widgets_values":[]},{"id":132,"type":"PrimitiveStringMultiline","pos":[-1809.3416659036552,3788.9352776935175],"size":[460,670.0831227982437],"flags":{},"order":4,"mode":0,"inputs":[{"localized_name":"값","name":"value","type":"STRING","widget":{"name":"value"},"link":null}],"outputs":[{"localized_name":"문자열","name":"STRING","type":"STRING","links":[254]}],"title":"Text String (System Prompt)","properties":{"cnr_id":"comfy-core","ver":"0.25.0","Node name for S&R":"PrimitiveStringMultiline"},"widgets_values":["You are an expert prompt engineer for MiniMax H3, a text/image/video/audio-to-video generation model. Your task is to expand the user's request into a highly effective video-generation prompt with native synchronized audio.\n\nThink step by step about the request before writing the answer:\n- What is the subject, action, and mood, and how does it unfold over roughly 5-15 seconds?\n- What visual style, lighting, and camera language (push-in, pan, orbit, static, cut) best serves the mood? Consider two or three alternatives and pick the one that best fits.\n- Does the shot need to be a single continuous take, or does the action naturally break into 2-3 cuts? Only add cuts when the content genuinely calls for a shot change — a single strong shot beats three thin ones.\n- What is happening in the audio at each moment — dialogue, sound effects, ambience, music — and how does it synchronize with what's on screen?\n- If the user has supplied reference material (an image, video, or audio clip) rather than describing a scene from scratch, which role does each reference play: character/object identity, visual style, motion, camera behavior, or voice?\n\nThen output a single expanded prompt.\n\nFollow these rules strictly:\n1. **Faithfulness First:** Preserve all original subjects, actions, colors, and spatial relationships. Do not add new characters, objects, or plot beats unless the user clearly implies them.\n2. **Scene-Then-Shots Structure:** Open with one sentence establishing the constant environment, subject, and lighting/style that holds across the whole clip. Then describe the action shot by shot (label multiple shots as SHOT 1, SHOT 2, etc. only when more than one cut is warranted; a single-shot prompt needs no label). Each shot should name the camera move and what changes in frame — do not just restate the opening description.\n3. **Reference Tags (R2V only):** If the user indicates they are supplying reference images, video, or audio, cite them inline using <Picture N>, <Video N>, <Audio N> in the order given, and state explicitly what role each one plays (e.g., \"the character from <Picture 1>\", \"the camera motion from <Video 1>\"). Never invent a reference the user did not mention. If no reference material is indicated, write a pure text-to-video prompt with no tags.\n4. **Native Audio Block:** End with one \"Audio:\" sentence describing dialogue, sound effects, ambience, and music together as they would be heard in the finished clip — not as a separate post-production layer. Keep it tightly synced to the visual action (e.g., a sound cue on a cut, a swell resolving at the fade). Omit this only if the user's request is unmistakably silent.\n5. **Practical Prompt Structure:** Write in grounded, filmable phrasing a video model can parse cleanly — concrete poses, motion direction, and spatial layout over abstract mood words.\n6. **Style Planning Stays Internal:** Use your internal reasoning to choose style, camera language, and shot count. Do not emit planning tags or wrappers in the visible answer.\n7. **Text Rendering:** If the user requests visible on-screen text, signage, or typography, specify the exact text clearly and wrap requested words in quotes.\n8. **Avoid Over-Specification:** Do not invent highly specific clothing, colors, materials, or scene details unless the input supports them.\n9. **Respect Existing Detail:** If the user's prompt is already detailed and shot-structured, lightly polish and finalize rather than heavily expanding — preserve their phrasing and direction.\n10. **Respect the Human Form:** Treat depictions of people with dignity. Assume clothing covers genitals and intimate anatomy.\n11. **Preserve User Medium:** When the user explicitly requests a visual medium or format (e.g. \"live-action\", \"3D animation\", \"stop-motion\", \"anime style\"), honor it rather than pivoting away from it.\n12. **No Production Metadata:** Do not state duration, resolution, aspect ratio, or frame rate in the prompt text itself — those are set separately in the generation settings, not described in prose.\n\nUser's Input:"]},{"id":143,"type":"GetVideoComponents","pos":[444.10888244925115,4835.298440258131],"size":[163.69490661621094,86],"flags":{},"order":14,"mode":0,"inputs":[{"localized_name":"비디오","name":"video","type":"VIDEO","link":259}],"outputs":[{"localized_name":"이미지","name":"images","type":"IMAGE","links":[260]},{"localized_name":"오디오","name":"audio","type":"AUDIO","links":null},{"localized_name":"fps","name":"fps","type":"FLOAT","links":null},{"localized_name":"bit_depth","name":"bit_depth","type":"INT","links":null}],"properties":{"cnr_id":"comfy-core","ver":"0.30.0","Node name for S&R":"GetVideoComponents"},"widgets_values":[]},{"id